# Copy this file to .env.local and fill in real values.
# Next.js only reads .env.local, not this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth → URL configuration must include:
#   http://localhost:3000/auth/callback
#   https://YOUR-APP.vercel.app/auth/callback
# That same callback is used for email confirm and password reset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Nigeria and other African merchant countries)
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Optional. Held creates USD plans named "Held monthly" and "Held yearly" if these are empty.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=

# Resend (booking emails)
# https://resend.com/api-keys
# Until you verify a domain, Resend only delivers to the email on that Resend account.
RESEND_API_KEY=
RESEND_FROM=Held <onboarding@resend.dev>

# Google Calendar. Use a Web application OAuth client.
# Enable the Google Calendar API.
# Authorized redirect URI must match the site you are on, exactly:
#   http://localhost:3000/api/google/callback
#   https://YOUR-APP.vercel.app/api/google/callback
# While the consent screen is in Testing, add your Google account as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Vercel Cron sends this automatically on paid plans.
# Local test: GET /api/cron/reminders with Authorization: Bearer CRON_SECRET
# Optional. If set, package drafts can use this. Without it, Held still drafts from the text you type.
OPENAI_API_KEY=

# Optional. Public Google Business Profile URL, once Google gives you one.
# Add it so search can connect the company page to the profile.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=