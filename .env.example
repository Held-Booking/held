# Copy this file to .env.local and fill in real values.
# Next.js only reads .env.local, not this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API
# URL must look like https://abcdxyz.supabase.co  (not just the project id)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (Nigeria and other African merchant countries)
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Optional. Held creates USD plans named "Held monthly" and "Held yearly" if these are empty.
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=

# Resend (booking emails)
# https://resend.com/api-keys
# Until you verify a domain, Resend only delivers to the email on that Resend account.
RESEND_API_KEY=
RESEND_FROM=Held <onboarding@resend.dev>

# Google Calendar. Redirect URI: {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Vercel Cron sends this automatically on paid plans.
# Local test: GET /api/cron/reminders with Authorization: Bearer CRON_SECRET
CRON_SECRET=